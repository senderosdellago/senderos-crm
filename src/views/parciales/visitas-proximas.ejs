<% if (visitas.length === 0) { %>
  <p class="texto-discreto">No hay visitas agendadas por ahora.</p>
<% } %>
<% visitas.forEach((v) => { %>
  <div class="tarjeta-visita" data-telefono="<%= v.telefono %>">
    <div class="tarjeta-visita-info">
      <span class="tarjeta-lead-nombre"><%= v.nombre || v.telefono %></span>
      <span class="tarjeta-visita-fecha"><%= v.fecha_visita_iso %><%= v.hora_visita_pendiente ? ` — ${v.hora_visita_pendiente}` : "" %></span>
      <span class="tarjeta-visita-tipo"><%= v.tipo_visita === "oficina" ? "Reunión en oficina" : "Visita al proyecto" %></span>
    </div>
    <a class="boton boton-secundario" href="/conversacion/<%= producto %>/<%= v.telefono %>">Ver conversación</a>
  </div>
<% }) %>
