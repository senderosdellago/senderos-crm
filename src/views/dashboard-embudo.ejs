<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Embudo de ventas — <%= productoActual.nombre %></title>
  <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>
  <header class="encabezado">
    <div class="encabezado-marca">
      <img src="/img/logo-senderos.png" alt="Senderos del Lago" class="encabezado-logo" />
      <strong><%= productoActual.nombre %></strong>
    </div>
    <nav class="nav-principal">
      <a href="/dashboard?producto=<%= productoActual.slug %>">Dashboard</a>
      <a href="/dashboard/embudo?producto=<%= productoActual.slug %>" class="activo">Embudo</a>
      <a href="/bandeja?producto=<%= productoActual.slug %>">Bandeja</a>
    </nav>
    <div class="encabezado-usuario">
      <span><%= usuario.nombre %></span>
      <form method="POST" action="/logout"><button type="submit" class="boton-enlace">Salir</button></form>
    </div>
  </header>

  <main class="contenedor-embudo">
    <div class="embudo-titulo-fila">
      <h1 class="titulo-pagina" style="margin:0">Embudo de ventas</h1>
      <a class="enlace-volver" href="/dashboard/oportunidades?producto=<%= productoActual.slug %>">Ver como tabla →</a>
    </div>
    <p class="texto-discreto">Arrastra una tarjeta a otra columna para cambiar su etapa.</p>

    <% if (usuario.rol === "admin") { %>
      <div class="filtro-etapa-contenedor">
        <label for="filtro-asesor-embudo">Ver leads de:</label>
        <select id="filtro-asesor-embudo" onchange="window.location.href = '/dashboard/embudo?producto=<%= productoActual.slug %>&asesor=' + this.value">
          <option value="todos" <%= asesorFiltro === "todos" ? "selected" : "" %>>Todos</option>
          <% usuariosActivos.forEach((u) => { %>
            <option value="<%= u.id %>" <%= asesorFiltro === String(u.id) ? "selected" : "" %>><%= u.nombre %></option>
          <% }) %>
        </select>
      </div>
    <% } %>

    <div class="tablero-embudo">
      <% columnas.forEach((col) => { %>
        <div class="columna-embudo" data-etapa-id="<%= col.id %>" data-etapa-nombre="<%= col.nombre %>">
          <div class="columna-embudo-encabezado">
            <strong><%= col.nombre %></strong>
            <span class="texto-discreto"><%= col.leads.length %> lead<%= col.leads.length === 1 ? "" : "s" %> · <%= col.porcentajeDelTotal %>%<% if (col.totalValor > 0) { %> · $<%= col.totalValor.toLocaleString("es-CO") %><% } %></span>
          </div>
          <div class="columna-embudo-cuerpo">
            <% if (col.leads.length === 0) { %>
              <p class="texto-discreto columna-embudo-vacia">Sin leads aquí</p>
            <% } %>
            <% col.leads.forEach((lead) => { %>
              <div class="tarjeta-embudo" draggable="true" data-telefono="<%= lead.telefono %>">
                <div class="tarjeta-embudo-info">
                  <div class="tarjeta-embudo-linea1">
                    <input type="text" class="campo-nombre-editable tarjeta-embudo-nombre" data-telefono="<%= lead.telefono %>" value="<%= lead.nombre || '' %>" placeholder="Sin nombre" onmousedown="event.stopPropagation()" />
                    <a href="/conversacion/<%= productoActual.slug %>/<%= lead.telefono %>" class="tarjeta-embudo-link" title="Ver conversación">💬</a>
                  </div>
                  <div class="tarjeta-embudo-linea2">
                    <span><%= lead.telefono %></span>
                    <span><%= lead.valor_venta ? "$" + lead.valor_venta.toLocaleString("es-CO") : "Sin valor" %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <script>
    const PRODUCTO = "<%= productoActual.slug %>";
  </script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
