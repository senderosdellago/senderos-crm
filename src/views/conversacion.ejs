<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= telefono %> — <%= productoActual.nombre %></title>
  <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>
  <header class="encabezado">
    <div class="encabezado-marca">
      <img src="/img/logo-senderos.png" alt="Senderos del Lago" class="encabezado-logo" />
      <a href="/bandeja?producto=<%= productoActual.slug %>" class="boton-enlace">&larr; Bandeja</a>
      <strong><%= telefono %></strong>
      <span id="estado-conexion" class="punto-conexion"></span>
    </div>
    <div>
      <% if (usuario.rol === "admin") { %>
        <select id="selector-asesor" data-producto="<%= productoActual.slug %>" data-telefono="<%= telefono %>">
          <option value="">Sin asignar</option>
          <% asesores.forEach((a) => { %>
            <option value="<%= a.id %>" <%= leadCrm.asesor_id === a.id ? "selected" : "" %>><%= a.nombre %></option>
          <% }) %>
        </select>
      <% } %>
      <select id="selector-etapa" data-producto="<%= productoActual.slug %>" data-telefono="<%= telefono %>">
        <% etapas.forEach((e) => { %>
          <option value="<%= e.id %>" <%= leadCrm.etapa_id === e.id ? "selected" : "" %>><%= e.nombre %><%= e.porcentaje != null ? ` (${e.porcentaje}%)` : "" %></option>
        <% }) %>
      </select>
    </div>
  </header>

  <main class="contenedor-conversacion">
    <div class="panel-resumen">
      <div><span class="resumen-etiqueta">Nombre</span><span><%= conversacion.respuestas?.nombre || "No capturado" %></span></div>
      <div><span class="resumen-etiqueta">Clasificación</span><span class="etiqueta etiqueta-<%= conversacion.clasificacion %>"><%= conversacion.clasificacion %></span></div>
      <div><span class="resumen-etiqueta">Uso</span><span><%= conversacion.respuestas?.uso || "No especificado" %></span></div>
      <div><span class="resumen-etiqueta">Presupuesto</span><span><%= conversacion.respuestas?.presupuesto || "No especificado" %></span></div>
      <div><span class="resumen-etiqueta">Tiempo de decisión</span><span><%= conversacion.respuestas?.tiempo || "No especificado" %></span></div>
      <div><span class="resumen-etiqueta">Visita</span><span><%= conversacion.visita_agendada ? `Agendada — ${conversacion.fecha_visita_iso} ${conversacion.hora_visita_pendiente || ""}` : "No agendada" %></span></div>
      <div><span class="resumen-etiqueta">Asesor a cargo</span><span><%= leadCrm.asesor_id ? (asesores.find((a) => a.id === leadCrm.asesor_id)?.nombre || "—") : "Sin asignar" %></span></div>
    </div>

    <div class="panel-herramientas">
      <div class="panel-asistente">
        <button id="boton-sugerir" class="boton boton-secundario">Sugerir próximo paso (IA)</button>
        <div id="resultado-sugerencia" class="resultado-sugerencia" hidden></div>
      </div>
      <div class="panel-notas">
        <label for="campo-notas">Notas internas del asesor</label>
        <textarea id="campo-notas" rows="2" placeholder="Ej: la llamé, no contestó, reintentar mañana en la tarde..."><%= leadCrm.notas || "" %></textarea>
        <button id="boton-guardar-notas" class="boton boton-secundario">Guardar nota</button>
        <span id="estado-notas" class="texto-discreto"></span>
      </div>

      <div class="panel-tareas">
        <div class="panel-tareas-encabezado">
          <span class="resumen-etiqueta">Tareas de este lead</span>
          <button id="boton-abrir-tarea" class="boton boton-secundario">+ Próxima tarea</button>
        </div>

        <form id="form-tarea" class="form-tarea oculta">
          <select id="selector-concepto-tarea">
            <option value="Enviar propuesta económica">Enviar propuesta económica</option>
            <option value="Enviar borrador promesa compraventa">Enviar borrador promesa compraventa</option>
            <option value="Llamar nuevamente">Llamar nuevamente</option>
            <option value="Enviar un mensaje de seguimiento">Enviar un mensaje de seguimiento</option>
            <option value="Reagendar visita">Reagendar visita</option>
            <option value="otro">Otro...</option>
          </select>
          <input type="text" id="campo-concepto-otro" placeholder="Describe la tarea..." class="oculta" />
          <input type="date" id="campo-fecha-tarea" required />
          <button type="submit" class="boton">Crear tarea</button>
        </form>

        <ul id="lista-tareas" class="lista-tareas">
          <% tareas.forEach((t) => { %>
            <li class="<%= t.completada ? 'tarea-completada' : '' %>" data-tarea-id="<%= t.id %>">
              <span><%= t.concepto %> — <%= new Date(t.fecha).toLocaleDateString("es-CO", { timeZone: "America/Bogota", day: "numeric", month: "short" }) %></span>
              <% if (!t.completada) { %>
                <button class="boton-completar-tarea-inline" data-tarea-id="<%= t.id %>">Completada</button>
              <% } else { %>
                <span class="texto-discreto">✓ hecha</span>
              <% } %>
            </li>
          <% }) %>
          <% if (tareas.length === 0) { %>
            <li class="texto-discreto">Sin tareas todavía.</li>
          <% } %>
        </ul>
      </div>
    </div>

    <div id="lista-mensajes" class="lista-mensajes" data-producto="<%= productoActual.slug %>" data-telefono="<%= telefono %>">
      <%
        let diaAnterior = null;
        (conversacion.historial || []).forEach((m) => {
          const fecha = m.timestamp ? new Date(m.timestamp) : null;
          const diaActual = fecha ? fecha.toLocaleDateString("es-CO", { timeZone: "America/Bogota", day: "numeric", month: "long", year: "numeric" }) : null;
          const mostrarSeparador = diaActual && diaActual !== diaAnterior;
          if (mostrarSeparador) diaAnterior = diaActual;
      %>
        <% if (mostrarSeparador) { %>
          <div class="separador-dia"><span><%= diaActual %></span></div>
        <% } %>
        <div class="burbuja burbuja-<%= m.role %>">
          <span class="burbuja-texto"><%= m.content %></span>
          <span class="burbuja-hora"><%= fecha ? fecha.toLocaleTimeString("es-CO", { timeZone: "America/Bogota", hour: "numeric", minute: "2-digit" }) : "hora no registrada" %></span>
        </div>
      <% }) %>
    </div>

    <div class="barra-acciones">
      <% if (conversacion.intervencion_humana) { %>
        <button id="boton-devolver" class="boton boton-secundario">Devolver al bot</button>
        <form id="form-mensaje" class="form-mensaje">
          <input type="text" id="campo-mensaje" placeholder="Escribe un mensaje..." autocomplete="off" />
          <button type="submit" class="boton">Enviar</button>
        </form>
      <% } else { %>
        <button id="boton-intervenir" class="boton">Tomar control de esta conversación</button>
      <% } %>
    </div>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const PRODUCTO = "<%= productoActual.slug %>";
    const TELEFONO = "<%= telefono %>";
  </script>
  <script src="/js/conversacion.js"></script>
</body>
</html>
