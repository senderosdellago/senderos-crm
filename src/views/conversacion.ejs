<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= telefono %> — <%= productoActual.nombre %></title>
  <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>
  <header class="encabezado">
    <div>
      <a href="/bandeja?producto=<%= productoActual.slug %>" class="boton-enlace">&larr; Bandeja</a>
      <strong><%= telefono %></strong>
      <span id="estado-conexion" class="punto-conexion"></span>
    </div>
    <div>
      <select id="selector-etapa" data-producto="<%= productoActual.slug %>" data-telefono="<%= telefono %>">
        <% etapas.forEach((e) => { %>
          <option value="<%= e.id %>" <%= leadCrm.etapa_id === e.id ? "selected" : "" %>><%= e.nombre %></option>
        <% }) %>
      </select>
    </div>
  </header>

  <main class="contenedor-conversacion">
    <div class="panel-herramientas">
      <div class="panel-asistente">
        <button id="boton-sugerir" class="boton boton-secundario">Sugerir próximo paso (IA)</button>
        <div id="resultado-sugerencia" class="resultado-sugerencia" hidden></div>
      </div>
      <div class="panel-notas">
        <label for="campo-notas">Notas internas del asesor</label>
        <textarea id="campo-notas" rows="2" placeholder="Ej: la llamé, no contestó, reintentar mañana en la tarde..."><%= leadCrm.notas || "" %></textarea>
        <button id="boton-guardar-notas" class="boton boton-secundario">Guardar nota</button>
        <span id="estado-notas" class="texto-discreto"></span>
      </div>
    </div>

    <div id="lista-mensajes" class="lista-mensajes" data-producto="<%= productoActual.slug %>" data-telefono="<%= telefono %>">
      <%
        let diaAnterior = null;
        (conversacion.historial || []).forEach((m) => {
          const fecha = m.timestamp ? new Date(m.timestamp) : null;
          const diaActual = fecha ? fecha.toLocaleDateString("es-CO", { timeZone: "America/Bogota", day: "numeric", month: "long", year: "numeric" }) : null;
          const mostrarSeparador = diaActual && diaActual !== diaAnterior;
          if (mostrarSeparador) diaAnterior = diaActual;
      %>
        <% if (mostrarSeparador) { %>
          <div class="separador-dia"><span><%= diaActual %></span></div>
        <% } %>
        <div class="burbuja burbuja-<%= m.role %>">
          <span class="burbuja-texto"><%= m.content %></span>
          <span class="burbuja-hora"><%= fecha ? fecha.toLocaleTimeString("es-CO", { timeZone: "America/Bogota", hour: "numeric", minute: "2-digit" }) : "hora no registrada" %></span>
        </div>
      <% }) %>
    </div>

    <div class="barra-acciones">
      <% if (conversacion.intervencion_humana) { %>
        <button id="boton-devolver" class="boton boton-secundario">Devolver al bot</button>
        <form id="form-mensaje" class="form-mensaje">
          <input type="text" id="campo-mensaje" placeholder="Escribe un mensaje..." autocomplete="off" />
          <button type="submit" class="boton">Enviar</button>
        </form>
      <% } else { %>
        <button id="boton-intervenir" class="boton">Tomar control de esta conversación</button>
      <% } %>
    </div>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const PRODUCTO = "<%= productoActual.slug %>";
    const TELEFONO = "<%= telefono %>";
  </script>
  <script src="/js/conversacion.js"></script>
</body>
</html>
