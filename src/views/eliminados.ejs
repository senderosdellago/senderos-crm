<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Eliminados — <%= productoActual.nombre %></title>
  <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>
  <header class="encabezado">
    <div class="encabezado-marca">
      <img src="/img/logo-senderos.png" alt="Senderos del Lago" class="encabezado-logo" />
      <strong><%= productoActual.nombre %></strong>
    </div>
    <nav class="nav-principal">
      <a href="/dashboard?producto=<%= productoActual.slug %>">Dashboard</a>
      <a href="/dashboard/embudo?producto=<%= productoActual.slug %>">Embudo</a>
      <a href="/dashboard/velocidad?producto=<%= productoActual.slug %>">Velocidad</a>
      <a href="/bandeja?producto=<%= productoActual.slug %>">Bandeja</a>
      <a href="/eliminados?producto=<%= productoActual.slug %>" class="activo">Eliminados</a>
      <a href="/cotizador" target="_blank">Cotizador</a>
    </nav>
    <div class="encabezado-usuario">
      <span><%= usuario.nombre %></span>
      <form method="POST" action="/logout"><button type="submit" class="boton-enlace">Salir</button></form>
    </div>
  </header>
  <main class="contenedor-dashboard">
    <a class="enlace-volver" href="/dashboard?producto=<%= productoActual.slug %>">← Volver al dashboard</a>
    <h1 class="titulo-pagina">Leads eliminados (<%= leadsEliminados.length %>)</h1>
    <p class="texto-discreto">
      Estos leads no aparecen en Bandeja, Embudo ni Oportunidades. El historial de WhatsApp con el cliente sigue intacto —
      eliminar aquí solo los saca de las pantallas activas del CRM. Se pueden restaurar en cualquier momento.
    </p>
    <table class="tabla-calendario">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Teléfono</th>
          <th>Última etapa</th>
          <th>Motivo</th>
          <th>Asesor</th>
          <th>Eliminado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (leadsEliminados.length === 0) { %>
          <tr><td colspan="7" class="texto-discreto">No hay leads eliminados por ahora.</td></tr>
        <% } %>
        <% leadsEliminados.forEach((lead) => { %>
          <tr data-telefono="<%= lead.telefono %>">
            <td><%= lead.nombre_override || "Sin nombre" %></td>
            <td><a href="/conversacion/<%= productoActual.slug %>/<%= lead.telefono %>"><%= lead.telefono %></a></td>
            <td><%= lead.etapa_nombre || "—" %></td>
            <td><%= lead.eliminado_motivo || "—" %></td>
            <td><%= lead.asesor_nombre || "Sin asignar" %></td>
            <td><%= new Date(lead.eliminado_en).toLocaleDateString("es-CO", { timeZone: "America/Bogota", day: "numeric", month: "short", year: "numeric" }) %></td>
            <td><button class="boton boton-secundario boton-restaurar-lead" data-telefono="<%= lead.telefono %>">Restaurar</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
  <script>
    const PRODUCTO = "<%= productoActual.slug %>";
    document.addEventListener("click", async (evento) => {
      const boton = evento.target.closest(".boton-restaurar-lead");
      if (!boton) return;

      const telefono = boton.dataset.telefono;
      boton.disabled = true;
      try {
        const respuesta = await fetch("/acciones/restaurar-lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ producto: PRODUCTO, telefono }),
        });
        if (!respuesta.ok) throw new Error("No se pudo restaurar el lead");
        boton.closest("tr").remove();
      } catch (error) {
        alert(error.message);
        boton.disabled = false;
      }
    });
  </script>
</body>
</html>
