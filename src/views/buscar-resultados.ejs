<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Buscar: <%= query %> — <%= productoActual.nombre %></title>
  <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>
  <header class="encabezado">
    <div class="encabezado-marca">
      <img src="/img/logo-senderos.png" alt="Senderos del Lago" class="encabezado-logo" />
      <strong><%= productoActual.nombre %></strong>
    </div>
    <nav class="nav-principal">
      <a href="/dashboard?producto=<%= productoActual.slug %>" class="activo">Dashboard</a>
      <a href="/dashboard/embudo?producto=<%= productoActual.slug %>">Embudo</a>
      <% if (usuario.rol === "admin") { %>
        <a href="/dashboard/velocidad?producto=<%= productoActual.slug %>">Velocidad</a>
      <% } %>
      <a href="/bandeja?producto=<%= productoActual.slug %>">Bandeja</a>
      <a href="/eliminados?producto=<%= productoActual.slug %>">Eliminados</a>
      <a href="/cotizador" target="_blank">Cotizador</a>
      <% if (usuario.accesoBrujula) { %>
        <a href="/brujula" target="_blank">Brújula</a>
      <% } %>
    </nav>
    <form class="form-buscador-header" action="/buscar" method="GET">
      <input type="hidden" name="producto" value="<%= productoActual.slug %>" />
      <input type="search" name="q" value="<%= query %>" placeholder="Buscar cliente (nombre o teléfono)" class="campo-buscador-header" />
    </form>
    <div class="encabezado-usuario">
      <span><%= usuario.nombre %></span>
      <form method="POST" action="/logout"><button type="submit" class="boton-enlace">Salir</button></form>
    </div>
  </header>

  <main class="contenedor-dashboard">
    <a class="enlace-volver" href="/dashboard?producto=<%= productoActual.slug %>">← Volver al dashboard</a>
    <h1 class="titulo-pagina">Resultados para "<%= query %>" (<%= resultados.length %>)</h1>

    <% if (resultados.length === 0) { %>
      <p class="texto-discreto">No se encontró ningún cliente con ese nombre o teléfono.</p>
    <% } else { %>
      <table class="tabla-calendario">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Etapa</th>
            <% if (usuario.rol === "admin") { %><th>Asesor</th><% } %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% resultados.forEach((r) => { %>
            <tr>
              <td><%= r.nombre %></td>
              <td><%= r.telefono %></td>
              <td><%= r.etapa_nombre || "—" %></td>
              <% if (usuario.rol === "admin") { %><td><%= r.asesor_nombre || "Sin asignar" %></td><% } %>
              <td><a class="boton boton-secundario" href="/conversacion/<%= productoActual.slug %>/<%= r.telefono %>">Ver</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>

  <script>
    const PRODUCTO = "<%= productoActual.slug %>";
  </script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
